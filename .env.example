BOT_TOKEN=your_telegram_bot_token
ADMIN_IDS=
CHANNEL_ID=
PORT=7860

# webhook = production (default). polling = local dev only (clears production webhook).
BOT_UPDATE_MODE=webhook
WEBHOOK_URL=https://your-app.up.railway.app
WEBHOOK_SECRET=

# --- Database (pick one) ---
# Option A: SQLite (default, works without external DB)
DB_ENGINE=sqlite
SQLITE_PATH=rental_bot.db

# Option B: PostgreSQL (only if you want to use external DB)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DB_ENGINE=postgres

SUBSCRIPTION_CHANNEL=gebeya_mereja_266
PERSISTENCE_PATH=bot_data.pickle
MINI_APP_URL=


